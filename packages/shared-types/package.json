{
  "name": "@layermint/shared-types",
  "version": "0.1.2",
  "description": "Shared TypeScript contracts for LayerMint SDK packages.",
  "license": "MIT",
  "author": "LayerMint contributors",
  "homepage": "https://github.com/layermint/layermint-packages#readme",
  "bugs": {
    "url": "https://github.com/layermint/layermint-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/layermint/layermint-packages.git"
  },
  "keywords": [
    "layermint",
    "types",
    "contracts",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "echo 'shared-types lint placeholder'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
