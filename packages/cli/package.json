{
  "name": "@layermint/cli",
  "version": "0.2.0",
  "description": "CLI for checking LayerMint srcRoot override resolution, graphs, and diffs.",
  "license": "MIT",
  "author": "LayerMint contributors",
  "homepage": "https://github.com/layermint/layermint-packages#readme",
  "bugs": {
    "url": "https://github.com/layermint/layermint-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/layermint/layermint-packages.git"
  },
  "keywords": [
    "layermint",
    "variants",
    "override",
    "overrides",
    "multitenant",
    "multi-tenant",
    "whitelabel",
    "white-label",
    "without-fork",
    "no-fork",
    "theming",
    "cli",
    "typescript"
  ],
  "type": "module",
  "bin": {
    "variant": "dist/index.js"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "echo 'cli lint placeholder'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@layermint/sdk-vite": "workspace:*",
    "@layermint/shared-types": "workspace:*",
    "commander": "^13.1.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
