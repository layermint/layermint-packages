{
  "name": "@layermint/sdk-core",
  "version": "0.2.0",
  "description": "Core LayerMint engine for srcRoot override resolution and contract checks.",
  "license": "MIT",
  "author": "LayerMint contributors",
  "homepage": "https://github.com/layermint/layermint-packages#readme",
  "bugs": {
    "url": "https://github.com/layermint/layermint-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/layermint/layermint-packages.git"
  },
  "keywords": [
    "layermint",
    "core",
    "variants",
    "override",
    "overrides",
    "multitenant",
    "multi-tenant",
    "whitelabel",
    "white-label",
    "without-fork",
    "no-fork",
    "theming",
    "customization",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./engine": {
      "types": "./dist/engine.d.ts",
      "import": "./dist/engine.js"
    },
    "./files": {
      "types": "./dist/files.d.ts",
      "import": "./dist/files.js"
    },
    "./exports": {
      "types": "./dist/exports.d.ts",
      "import": "./dist/exports.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "echo 'sdk-core lint placeholder'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@layermint/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
