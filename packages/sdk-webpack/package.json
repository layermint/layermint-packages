{
  "name": "@layermint/sdk-webpack",
  "version": "0.2.0",
  "description": "Webpack plugin for LayerMint srcRoot overrides with symbol-level fallback.",
  "license": "MIT",
  "author": "LayerMint contributors",
  "homepage": "https://github.com/layermint/layermint-packages#readme",
  "bugs": {
    "url": "https://github.com/layermint/layermint-packages/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/layermint/layermint-packages.git"
  },
  "keywords": [
    "layermint",
    "webpack",
    "variants",
    "override",
    "overrides",
    "multitenant",
    "multi-tenant",
    "whitelabel",
    "white-label",
    "without-fork",
    "no-fork",
    "theming",
    "webpack-plugin",
    "typescript"
  ],
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "lint": "echo 'sdk-webpack lint placeholder'",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@layermint/sdk-core": "workspace:*",
    "@layermint/shared-types": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.8.2",
    "webpack": "^5.0.0"
  },
  "peerDependencies": {
    "webpack": "^5.0.0"
  },
  "files": [
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  }
}
